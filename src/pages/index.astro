---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const withBase = (path = "") => `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path}`;
const heroImage = withBase("assets/hero-main.jpg");
const mainHeroImage = withBase("assets/dtbf-hero.png");

const themes = [
  "The pressure to hold it together.",
  "The identities we outgrow.",
  "Neurodiversity and feeling different long before you have words for it.",
  "Addiction in all its forms.",
  "Burnout.",
  "Midlife.",
  "Starting over when you thought you'd already figured life out.",
  "Wanting more from life while also wanting to disappear from it."
];
---

<BaseLayout title="Dare to Break Free | Stories of Living, Learning & Letting Go">
  <section class="home-hero" style={`--hero-bg: url("${mainHeroImage}")`}>
    <div class="home-hero__copy">
      <h1>What does breaking free mean to you?</h1>
      <div class="hero-intro-copy">
        <p>Breaking free doesn't always mean blowing your life up and starting again (although it could). Sometimes you've just got to start somewhere, whether that's being honest with yourself about what's actually going on, doing something about that thing you know isn't helping but keep doing anyway, admitting the path you're on isn't working, or finally giving some attention to the idea you can't quite leave alone.</p>
        <p>Whatever that looks like for you, hello.</p>
      </div>
    </div>
  </section>

  <section class="editorial-section intro-panel">
    <div class="intro-panel__text">
      <p class="eyebrow">Intro</p>
      <h2>Hi, I'm Kali.</h2>
      <div class="editorial-copy stack">
        <p>Author of Dare to Break Free: <em>Drugs, Sex & Serendipity.</em></p>
        <p>I also work with people who are trying to figure out what they want to say, change, create or do next.</p>
        <p>For all the years I've spent coaching, studying psychology and doing more personal development than I can even account for, it was somewhere in the 21 revisions it took to finish my memoir that I realised I could understand my past inside out and still be ashamed of parts of it.</p>
        <p>I'd always been told, <strong>“Don't air your dirty laundry.”</strong> Instead, I'm letting mine fly free. Why? Because I will no longer let shame have a hold over me.</p>
        <p>Our stories matter. And I don't mean the bullshit we tell ourselves that keeps us stuck. I mean what has actually happened to us, what we've made it mean and how it could still be influencing our lives today.</p>
      </div>
    </div>
    <div class="image-placeholder editorial-image hero-image--photo">
      <img src={heroImage} alt="Temporary portrait placeholder for the future editorial image" />
      <span>Editorial image placeholder</span>
    </div>
  </section>

  <section class="healing-section">
    <div class="healing-section__copy">
      <p class="eyebrow">Reflection</p>
      <h2>Healing</h2>
    </div>
    <div class="reflection-grid">
      <article class="reflection-card">
        <div class="image-placeholder reflection-image">
          <span>Reflection image</span>
        </div>
        <h3>Find Your Words</h3>
        <p>Got something you're trying to get hold of, work through, say or bring into the world?</p>
        <p>I work one-to-one with people who need a thinking partner, useful questions and another brain in the room.</p>
        <a class="button secondary light-button" href={withBase("share-your-story/")}>Work with me</a>
      </article>
      <article class="reflection-card">
        <div class="image-placeholder reflection-image">
          <span>Reflection image</span>
        </div>
        <p>Some things helped. Others slowly became another form of escape or self-destruction.</p>
      </article>
      <article class="reflection-card">
        <div class="image-placeholder reflection-image">
          <span>Reflection image</span>
        </div>
        <p>More reflection copy can sit here when this part of the story is ready.</p>
      </article>
    </div>
  </section>

  <section class="themes-section">
    <div class="themes-section__heading">
      <p class="eyebrow">Themes</p>
      <h2>What This Space Explores</h2>
    </div>
    <div class="theme-lines">
      {themes.map((theme, index) => (
        <h3 class={`theme-line theme-line--${index + 1}`}>{theme}</h3>
      ))}
    </div>
    <div class="mini-image-row" aria-label="Future imagery placeholders">
      <div class="image-placeholder mini-image"><span>Detail image</span></div>
      <div class="image-placeholder mini-image"><span>Texture image</span></div>
      <div class="image-placeholder mini-image"><span>Memory image</span></div>
    </div>
  </section>

  <section class="memoir-section">
    <div class="memoir-section__copy">
      <p class="eyebrow">Memoir</p>
      <h2>The Memoir</h2>
      <div class="stack">
        <p>Dare to Break Free started as an idea in 2009 and took seventeen years to finish.</p>
        <p>Somewhere in all of that, life happened.</p>
        <p>I wanted to write a memoir not only for my own healing, but in the hope it might help someone else feel a little less alone in theirs.</p>
        <p>It's about what happens after survival too.</p>
      </div>
      <a class="button secondary light-button" href={withBase("book/")}>About the book</a>
    </div>
    <div class="image-placeholder book-image">
      <span>Book cover / manuscript image placeholder</span>
    </div>
  </section>

  <section class="section latest-section">
    <div class="section-heading">
      <p class="eyebrow">Latest writing</p>
      <h2>From the blog</h2>
    </div>
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="final-cta">
    <div class="image-placeholder final-image">
      <span>Final background image placeholder</span>
    </div>
    <div class="final-cta__copy">
      <h2>Still Figuring It Out</h2>
      <p>If you've ever felt trapped by who you were supposed to be, you're probably in the right place.</p>
      <a class="button" href={withBase("blog/")}>Read the blog</a>
    </div>
  </section>
</BaseLayout>
