---
import "../styles/global.css";
import "../styles/homepage-typography.css";
import "../styles/definition-section.css";
import "../styles/memoir-section.css";
import "../styles/heading-scale.css";
import "../styles/site-gutters.css";
import shareImageAsset from "../assets/home-page-hero-main.png";

const {
  title = "Dare to Break Free",
  description = "Stories of Living, Learning & Letting Go",
  pageClass = "",
  noindex = false,
  schema = null,
  ogType = "website"
} = Astro.props;

const withBase = (path = "") => `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path}`;
const logoSrc = `${withBase("assets/dtbf-logo.png")}?v=3`;
const faviconSrc = `${withBase("assets/dtbf-favicon.png")}?v=11`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(shareImageAsset.src, Astro.site).href;
const defaultSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Dare to Break Free",
    url: new URL(withBase(), Astro.site).href
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Kali Harmen",
    url: new URL(withBase("about/"), Astro.site).href
  }
];
const jsonLd = JSON.stringify(schema ?? defaultSchema).replaceAll("<", "\\u003c");
const navItems = [
  { href: withBase(), label: "Home" },
  { href: withBase("work-with-me/"), label: "Work With Me" },
  { href: withBase("book/"), label: "The Book" },
  { href: withBase("about/"), label: "About" },
  { href: withBase("journal/"), label: "Journal" },
  { href: withBase("speaking/"), label: "Speaking" }
];
const currentPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const homePath = withBase();
const isCurrentNavItem = (href: string) => href === homePath
  ? currentPath === homePath
  : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Dare to Break Free" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:alt" content="Kali Harmen and Dare to Break Free" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <script is:inline type="application/ld+json" set:html={jsonLd}></script>
    <link rel="icon" type="image/png" href={faviconSrc} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Marcellus&family=Merriweather:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body class={pageClass}>
    <div class="site-frame">
      <a class="skip-link" href="#main-content">Skip to content</a>
      <header class="site-header">
        <a class="brand" href={withBase()} aria-label="Dare to Break Free home">
          <img src={logoSrc} alt="Dare to Break Free" width="4275" height="1028" fetchpriority="high" />
        </a>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
          <span class="menu-toggle__line"></span>
          <span class="menu-toggle__line"></span>
          <span class="menu-toggle__line"></span>
          <span class="sr-only">Menu</span>
        </button>
        <nav class="nav" id="primary-nav" aria-label="Primary navigation">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isCurrentNavItem(item.href) ? "page" : undefined}>{item.label}</a>
          ))}
        </nav>
      </header>
      <main id="main-content">
        <slot />
      </main>
      <footer class="site-footer">
        <p>Dare to Break Free</p>
      </footer>
    </div>
    <script>
      const menuToggle = document.querySelector(".menu-toggle");
      const primaryNav = document.querySelector("#primary-nav");

      menuToggle?.addEventListener("click", () => {
        const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!isOpen));
        primaryNav?.classList.toggle("is-open", !isOpen);
      });
    </script>
  </body>
</html>
