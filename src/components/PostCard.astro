---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const withBase = (path = "") => `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path}`;
---

<article class="post-card">
  {post.data.coverImage && (
    <div class="post-card__media">
      <img
        class="post-card__image"
        src={withBase(post.data.coverImage.replace(/^\/+/, ""))}
        alt=""
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  <h3><a href={withBase(`journal/${post.slug}/`)}>{post.data.title}</a></h3>
  <p>{post.data.excerpt}</p>
  <div class="tag-list" aria-label="Post tags">
    {post.data.tags.map((tag) => <span>{tag}</span>)}
  </div>
</article>
