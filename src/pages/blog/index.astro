---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const themes = [
  {
    name: "Midlife",
    description: "Starting over, changing shape, ambition, burnout and what happens when the old plan stops fitting.",
    tags: ["midlife", "burnout", "starting over"]
  },
  {
    name: "Neurodiversity",
    description: "ADHD, difference, sensory overwhelm, masking and finally finding language for what never quite made sense.",
    tags: ["neurodiversity", "adhd"]
  },
  {
    name: "Writing",
    description: "Memoir, truth-telling, voice, shame, process and the strange business of putting a life into words.",
    tags: ["writing", "memoir"]
  },
  {
    name: "Relationships",
    description: "Sex, love, intimacy, friendship, family, boundaries and the stories we carry into other people.",
    tags: ["relationships", "sex", "family"]
  },
  {
    name: "Recovery",
    description: "Addiction, escape, self-destruction, healing and the less tidy parts of becoming free.",
    tags: ["recovery", "addiction", "healing"]
  },
  {
    name: "Work & Ambition",
    description: "Self-employment, work, money, visibility, wanting more and wondering what it costs.",
    tags: ["work", "ambition", "self-employment"]
  }
];

const getThemeCount = (theme: typeof themes[number]) =>
  posts.filter((post) =>
    post.data.tags.some((tag) => theme.tags.includes(tag.toLowerCase()))
  ).length;
---

<BaseLayout title="Journal | Dare to Break Free">
  <section class="page-hero journal-hero">
    <div class="journal-hero__intro">
      <p class="eyebrow">Journal</p>
      <h1>Most people only tell the cleaned-up version once they know how the story ends.</h1>
    </div>
    <div class="intro-copy journal-hero__copy">
      <p>This journal isn't that.</p>
      <p>A few pieces come from memories I thought I'd buried properly. Others come from things I'm still trying to understand in real time.</p>
      <p>The good days, the messy ones, the moments where things finally make sense, and the moments where they completely don't.</p>
      <p>Nothing here is about pretending to have the perfect answer. It's about being honest about the process.</p>
    </div>
  </section>

  <section class="section journal-themes-section">
    <div class="section-heading">
      <p class="eyebrow">Browse by theme</p>
      <h2>Follow the thread that finds you first.</h2>
    </div>
    <div class="journal-theme-grid">
      {themes.map((theme) => {
        const count = getThemeCount(theme);
        return (
          <article class="journal-theme-card">
            <h3>{theme.name}</h3>
            <p>{theme.description}</p>
            <span>{count === 1 ? "1 entry" : `${count} entries`}</span>
          </article>
        );
      })}
    </div>
  </section>

  <section class="section journal-index-section">
    <div class="section-heading">
      <p class="eyebrow">Latest entries</p>
      <h2>New writing will collect here.</h2>
    </div>
    <div class="post-grid journal-index-grid">
      {posts.length > 0 ? (
        posts.map((post) => <PostCard post={post} />)
      ) : (
        <article class="post-card journal-empty-card">
          <h3>Journal entries coming soon</h3>
          <p>When the first pieces are ready, they’ll appear here automatically.</p>
        </article>
      )}
    </div>
  </section>
</BaseLayout>
