---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection, render } from "astro:content";
import "../../styles/journal-article.css";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      imageOnRight: index % 2 === 1,
      nextPosts: posts
        .filter((entry) => entry.id !== post.id)
        .slice(0, 3)
    }
  }));
}

const { post, imageOnRight, nextPosts } = Astro.props;
const { Content } = await render(post);
const siteUrl = Astro.site ?? new URL("https://daretobreakfree.co.uk");
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.metaDescription ?? post.data.excerpt,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  mainEntityOfPage: new URL(`journal/${post.slug}/`, siteUrl).href,
  author: {
    "@type": "Person",
    name: "Kali Harmen",
    url: new URL("about/", siteUrl).href
  },
  publisher: {
    "@type": "Organization",
    name: "Dare to Break Free",
    url: siteUrl.href
  },
  ...(post.data.coverImage ? { image: new URL(post.data.coverImage, Astro.site).href } : {})
};
---

<BaseLayout title={post.data.seoTitle ?? `${post.data.title} | Dare to Break Free`} description={post.data.metaDescription ?? post.data.excerpt} pageClass="article-page" schema={articleSchema} ogType="article">
  {post.data.coverImage && (
    <header class={`article-hero${imageOnRight ? " article-hero--image-right" : ""}${post.slug === "when-nine-minutes-of-netflix-takes-an-hour-and-a-half" ? " article-hero--square-image" : ""}`}>
      <div class="article-hero__inner">
        <div class="article-hero__image">
          <img src={post.data.coverImage} alt={post.data.coverAlt ?? ""} />
        </div>
        <div class="article-hero__content">
          <h1>{post.data.title}</h1>
        </div>
      </div>
    </header>
  )}
  <article class="article">
    {!post.data.coverImage && (
      <>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.excerpt}</p>
      </>
    )}
    <div class="prose">
      <Content />
    </div>
  </article>
  <section class="article-next" aria-labelledby="article-next-title">
    <div class="article-next__inner">
      <div class="article-next__heading">
        <p class="eyebrow">Keep reading</p>
        <h2 id="article-next-title">What to read next</h2>
      </div>
      {nextPosts.length > 0 && (
        <div class="article-next__grid">
          {nextPosts.map((nextPost) => <PostCard post={nextPost} />)}
        </div>
      )}
      <a class="article-next__all" href={`${import.meta.env.BASE_URL}journal/`}>Browse all journal entries</a>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const requestedGutter = new URLSearchParams(window.location.search).get("gutter");
  if (requestedGutter === "plum" || requestedGutter === "teal") {
    document.body.dataset.gutter = requestedGutter;
  }
</script>
