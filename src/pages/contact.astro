---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/speaking-page.css";
import speakingHero from "../assets/speaking-page-hero.jpg";

const formAction = "https://formspree.io/f/xwlpaqpg";
---

<BaseLayout title="Speaking | Dare to Break Free">
  <section class="page-hero speaking-hero" style={`--speaking-hero-image: url("${speakingHero.src}")`}>
    <div class="speaking-hero__copy">
      <h1>Speaking</h1>
      <p class="lede">Invite Kali to speak</p>
    </div>
  </section>

  <section class="form-section">
    <div>
      <p class="eyebrow">Message</p>
      <h2>Send a note</h2>
      <p>The site uses a form-first contact flow so the public email address does not have to sit exposed on every page.</p>
    </div>
    <form class="contact-form" action={formAction} method="POST">
      <div class="contact-form__honeypot" aria-hidden="true">
        <label for="contact-website">Leave this field empty</label>
        <input id="contact-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <label>
        Name
        <input name="name" type="text" autocomplete="name" required />
      </label>
      <label>
        Email
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label>
        Message
        <textarea name="message" rows="7" required></textarea>
      </label>
      <input type="hidden" name="form-name" value="contact" />
      <button class="button" type="submit">Send message</button>
    </form>
  </section>
</BaseLayout>
