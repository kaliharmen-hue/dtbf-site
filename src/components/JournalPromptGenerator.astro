<section class="journal-prompt-section" aria-labelledby="journal-prompt-title">
  <div class="journal-prompt-section__inner">
    <div class="journal-prompt-section__intro">
      <p class="eyebrow">A moment for you</p>
      <h2 id="journal-prompt-title">Find a way in.</h2>
      <p>Bring a feeling, a question or a situation you want to explore. Or leave it blank and see what finds you.</p>
    </div>

    <div class="journal-prompt-tool">
      <form class="journal-prompt-form">
        <label for="journal-intention">What would you like to hold in mind?</label>
        <p class="journal-prompt-form__hint" id="journal-intention-hint">Optional. A few words is enough.</p>
        <div class="journal-prompt-form__controls">
          <input id="journal-intention" name="intention" type="text" maxlength="140" aria-describedby="journal-intention-hint" placeholder="For example, feeling stuck or starting again" />
          <button class="button secondary light-button" type="submit">Find a prompt</button>
        </div>
      </form>
      <div class="journal-prompt-result" aria-live="polite" aria-atomic="true" hidden>
        <p class="journal-prompt-result__intention" hidden></p>
        <p class="journal-prompt-result__question"></p>
      </div>
    </div>
  </div>
</section>

<script>
  const prompts = [
    "What feels most present for you right now, before you try to explain it away?",
    "What have you been needing more of lately, and how could you give yourself a little of it?",
    "What are you carrying that nobody else can see?",
    "When did you last feel most like yourself? What was present in that moment?",
    "What are you telling yourself you should be able to manage?",
    "What might change if you treated your own needs as useful information?",
    "What part of your life is asking for your attention, even quietly?",
    "What would you say to someone you love who was facing this same thing?",
    "What are you ready to stop pretending is fine?",
    "What has been giving you energy, even in small amounts?",
    "Which feeling have you been finding hardest to make room for?",
    "What do you know now that you wish you had known a year ago?",
    "What are you making mean something about you that might simply be difficult?",
    "Where in your life are you saying yes when you mean maybe, or no?",
    "What does your body seem to be asking for today?",
    "What are you longing to do, try or say, even if you are not ready yet?",
    "What would a kind next step look like, not the perfect one?",
    "What are you holding onto because letting go feels uncertain?",
    "When do you notice yourself shrinking or editing who you are?",
    "What would you like someone to understand about your experience?",
    "What is one thing you have handled that deserves more credit than you give it?",
    "What feels unfinished, and what would enough-for-now look like?",
    "What are you afraid might happen if you tell the truth about what you want?",
    "Which expectations are yours, and which have you inherited from someone else?",
    "What does feeling safe enough to be honest mean to you?",
    "What have you outgrown, even if you have not decided what comes next?",
    "What small moment from this week would you like to remember?",
    "What are you trying to solve that might first need to be felt?",
    "What do you wish you could ask for without having to justify it?",
    "What part of this situation is within your influence, however slightly?",
    "What are you avoiding, and what might the avoidance be protecting you from?",
    "What would you like to forgive yourself for not knowing sooner?",
    "Where are you waiting for permission you could give yourself?",
    "What does enough look like for you in this season of your life?",
    "Which relationship leaves you feeling more able to be yourself? What makes it so?",
    "What boundary might make more room for the life you want?",
    "What do you keep coming back to, even after you tell yourself to move on?",
    "What are you proud of that you rarely say out loud?",
    "If you did not need to get it right, what would you be curious to try?",
    "What is one thing you could make easier for yourself this week?",
    "What story about yourself are you ready to question?",
    "What would you like to have more courage for, and what support would help?",
    "When have you changed your mind about something important? What helped you?",
    "What is asking to be mourned, rather than fixed?",
    "What are you grateful for that can sit alongside what is hard?",
    "What would you like your future self to thank you for doing gently today?",
    "What do you need to hear, and can you offer yourself a version of those words?",
    "What feels like yours to carry, and what might belong to somebody else?",
    "What are you learning about the way you work, rest or make decisions?",
    "What would you do differently if you trusted that you could respond as things unfold?",
    "What have you been putting off until you feel more ready?",
    "What does connection with yourself feel like, even for a minute?",
    "What would it mean to take your own side in this situation?",
    "What is one thing you want to protect in the life you are building?",
    "Which part of your story have you not had the space to tell in your own words?",
    "What are you curious about in yourself right now?",
    "What could you let be imperfect today?",
    "What do you want to remember when this moment feels bigger than it is?",
    "What is one honest thing you can acknowledge without needing to act on it yet?",
    "If this chapter had a title, what might you call it?",
    "What would feeling a little more free look like in an ordinary day?"
  ];

  const form = document.querySelector<HTMLFormElement>(".journal-prompt-form");
  const intentionInput = document.querySelector<HTMLInputElement>("#journal-intention");
  const submitButton = form?.querySelector<HTMLButtonElement>("button[type='submit']");
  const result = document.querySelector<HTMLDivElement>(".journal-prompt-result");
  const intentionResult = document.querySelector<HTMLParagraphElement>(".journal-prompt-result__intention");
  const questionResult = document.querySelector<HTMLParagraphElement>(".journal-prompt-result__question");
  let remainingPrompts: string[] = [];
  let previousPrompt = "";

  function drawPrompt() {
    if (remainingPrompts.length === 0) {
      remainingPrompts = [...prompts];
      for (let index = remainingPrompts.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [remainingPrompts[index], remainingPrompts[swapIndex]] = [remainingPrompts[swapIndex], remainingPrompts[index]];
      }
      if (remainingPrompts[remainingPrompts.length - 1] === previousPrompt) {
        [remainingPrompts[0], remainingPrompts[remainingPrompts.length - 1]] = [remainingPrompts[remainingPrompts.length - 1], remainingPrompts[0]];
      }
    }

    previousPrompt = remainingPrompts.pop() ?? prompts[0];
    if (questionResult) questionResult.textContent = previousPrompt;

    const intention = intentionInput?.value.trim() ?? "";
    if (intentionResult) {
      intentionResult.textContent = intention ? `Holding this intention: ${intention}` : "";
      intentionResult.hidden = !intention;
    }
    if (result) result.hidden = false;
    if (submitButton) submitButton.textContent = "Another prompt";
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    drawPrompt();
  });
</script>

<style>
