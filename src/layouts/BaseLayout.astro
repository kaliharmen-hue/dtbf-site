---
import "../styles/global.css";

const {
  title = "Dare to Break Free",
  description = "Stories of Living, Learning & Letting Go"
} = Astro.props;

const withBase = (path = "") => `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${path}`;
const logoSrc = withBase("assets/dtbf-logo.png");
const faviconSrc = withBase("assets/dtbf-favicon.png");
const navItems = [
  { href: withBase(), label: "Home" },
  { href: withBase("share-your-story/"), label: "Work With Me" },
  { href: withBase("book/"), label: "The Book" },
  { href: withBase("blog/"), label: "Journal" },
  { href: withBase("contact/"), label: "Speaking" },
  { href: withBase("about/"), label: "About" }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={faviconSrc} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Marcellus&family=Merriweather:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={withBase()} aria-label="Dare to Break Free home">
        <img src={logoSrc} alt="Dare to Break Free" />
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
        <span class="menu-toggle__line"></span>
        <span class="menu-toggle__line"></span>
        <span class="menu-toggle__line"></span>
        <span class="sr-only">Menu</span>
      </button>
      <nav class="nav" id="primary-nav" aria-label="Primary navigation">
        {navItems.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Dare to Break Free</p>
      <p>Stories of Living, Learning & Letting Go</p>
    </footer>
    <script>
      const menuToggle = document.querySelector(".menu-toggle");
      const primaryNav = document.querySelector("#primary-nav");

      menuToggle?.addEventListener("click", () => {
        const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!isOpen));
        primaryNav?.classList.toggle("is-open", !isOpen);
      });
    </script>
  </body>
</html>
