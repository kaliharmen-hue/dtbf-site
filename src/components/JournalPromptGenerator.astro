    padding: clamp(3.5rem, 6vw, 6rem) var(--page-gutter);
    background: #eaf1f5;
    border-block: 1px solid rgba(85, 73, 113, 0.16);
  }

  .journal-prompt-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
    width: min(100%, 1480px);
    margin-inline: auto;
  }

  .journal-prompt-section__intro {
    max-width: 34rem;
  }

  .journal-prompt-section__intro .eyebrow {
    margin: 0 0 0.75rem;
    color: var(--accent-text);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .journal-prompt-section__intro h2 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .journal-prompt-section__intro > p:last-child {
    margin: 0;
    color: var(--muted);
  }

  .journal-prompt-tool {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: rgba(255, 255, 255, 0.76);
    border: 1px solid rgba(85, 73, 113, 0.2);
    border-left: 3px solid var(--accent);
    border-radius: 0.5rem;
    box-shadow: 0 0.65rem 1.8rem rgba(34, 38, 49, 0.08);
  }

  .journal-prompt-form label {
    display: block;
    margin-bottom: 0.2rem;
    font-weight: 700;
  }

  .journal-prompt-form__hint {
    margin: 0 0 0.8rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .journal-prompt-form__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .journal-prompt-form input {
    flex: 1 1 15rem;
    min-width: 0;
    min-height: 3.25rem;
    padding: 0.7rem 0.9rem;
    color: var(--ink);
    background: #fff;
    border: 1px solid rgba(85, 73, 113, 0.32);
    border-radius: 0.4rem;
    font: inherit;
    font-size: 1rem;
  }

  .journal-prompt-form input:focus-visible {
    outline: 3px solid var(--accent-text);
    outline-offset: 2px;
  }

  .journal-prompt-form .button {
    flex: 0 0 auto;
    min-height: 3.25rem;
    margin: 0;
    font-size: 1rem;
  }

  .journal-prompt-result:not([hidden]) {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(85, 73, 113, 0.2);
  }

  .journal-prompt-result__intention {
    margin: 0 0 0.65rem;
    color: var(--muted);
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }

  .journal-prompt-result__question {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2.5vw, 1.8rem);
    font-weight: 700;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  @media (max-width: 760px) {
    .journal-prompt-section__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .journal-prompt-section__intro {
      max-width: 42rem;
    }

    .journal-prompt-form__controls {
      align-items: stretch;
    }

    .journal-prompt-form input,
    .journal-prompt-form .button {
      width: 100%;
    }
  }
</style>
