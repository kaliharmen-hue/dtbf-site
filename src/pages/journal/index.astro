---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const themes = [
  {
    name: "Midlife",
    description: "Starting over, changing shape, ambition, burnout and what happens when the old plan stops fitting.",
    tags: ["midlife", "burnout", "starting over"]
  },
  {
    name: "Neurodiversity",
    description: "ADHD, difference, sensory overwhelm, masking and finally finding language for what never quite made sense.",
    tags: ["neurodiversity", "adhd"]
  },
  {
    name: "Writing",
    description: "Memoir, truth-telling, voice, shame, process and the strange business of putting a life into words.",
    tags: ["writing", "memoir"]
  },
  {
    name: "Relationships",
    description: "Sex, love, intimacy, friendship, family, boundaries and the stories we carry into other people.",
    tags: ["relationships", "sex", "family"]
  },
  {
    name: "Recovery",
    description: "Addiction, escape, self-destruction, healing and the less tidy parts of becoming free.",
    tags: ["recovery", "addiction", "healing"]
  },
  {
    name: "Work & Ambition",
    description: "Self-employment, work, money, visibility, wanting more and wondering what it costs.",
    tags: ["work", "ambition", "self-employment"]
  }
];

const getThemeCount = (theme: typeof themes[number]) =>
  posts.filter((post) =>
    post.data.tags.some((tag) => theme.tags.includes(tag.toLowerCase()))
  ).length;
---

<BaseLayout title="Journal | Dare to Break Free" description="Read Kali Harmen’s journal on midlife, ADHD, writing, relationships, recovery, work and ambition, with honest reflections on life as it happens.">
  <section class="page-hero journal-hero">
    <div class="journal-hero__intro">
      <h1><span>Writing in the</span><span>Here and Now</span></h1>
      <p class="journal-hero__lede">The good days, the messy ones, the moments where things finally make sense, and the moments where they completely don't.</p>
    </div>
  </section>

  <section class="section journal-themes-section">
    <div class="section-heading">
      <p class="eyebrow">Browse by theme</p>
      <h2>Follow the thread that finds you first.</h2>
    </div>
    <div class="journal-theme-grid">
      {themes.map((theme) => {
        const count = getThemeCount(theme);
        return (
          <button
            class="journal-theme-card"
            type="button"
            data-theme={theme.tags.map((tag) => tag.toLowerCase()).join("|")}
            data-theme-label={theme.name}
            aria-controls="journal-results"
            aria-pressed="false"
          >
            <span class="journal-theme-card__title" role="heading" aria-level="3">{theme.name}</span>
            <span class="journal-theme-card__description">{theme.description}</span>
            <span>{count === 1 ? "1 entry" : `${count} entries`}</span>
          </button>
        );
      })}
    </div>
  </section>

  <section class="section journal-index-section">
    <div class="section-heading">
      <div class="journal-results-heading">
        <h2 data-results-title>Latest Entries</h2>
        <button class="journal-filter-reset" type="button" data-theme-reset aria-controls="journal-results" aria-pressed="true">All entries</button>
      </div>
    </div>
    <div class="post-grid journal-index-grid" id="journal-results" aria-live="polite">
      {posts.length > 0 ? (
        posts.map((post) => <PostCard post={post} themeTags={post.data.tags.map((tag) => tag.toLowerCase()).join("|")} />)
      ) : (
        <article class="post-card journal-empty-card">
          <h3>Journal entries coming soon</h3>
          <p>When the first pieces are ready, they’ll appear here automatically.</p>
        </article>
      )}
    </div>
    <p class="journal-no-results" data-results-empty hidden>No entries in this theme yet.</p>
  </section>
</BaseLayout>

<script>
  const themeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".journal-theme-card"));
  const entryCards = Array.from(document.querySelectorAll<HTMLElement>(".journal-index-grid [data-theme-tags]"));
  const resultsTitle = document.querySelector<HTMLElement>("[data-results-title]");
  const emptyMessage = document.querySelector<HTMLElement>("[data-results-empty]");
  const resetButton = document.querySelector<HTMLButtonElement>("[data-theme-reset]");

  const showEntriesFor = (selectedTheme?: HTMLButtonElement) => {
    const selectedTags = selectedTheme?.dataset.theme?.split("|") ?? [];
    let visibleCount = 0;

    entryCards.forEach((card) => {
      const tags = card.dataset.themeTags?.split("|") ?? [];
      const visible = !selectedTheme || tags.some((tag) => selectedTags.includes(tag));
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    });

    themeButtons.forEach((button) => {
      button.setAttribute("aria-pressed", String(button === selectedTheme));
    });
    resetButton?.setAttribute("aria-pressed", String(!selectedTheme));
    if (resultsTitle) resultsTitle.textContent = selectedTheme ? `${selectedTheme.dataset.themeLabel} Entries` : "Latest Entries";
    if (emptyMessage) emptyMessage.hidden = visibleCount > 0;
  };

  themeButtons.forEach((button) => button.addEventListener("click", () => showEntriesFor(button)));
  resetButton?.addEventListener("click", () => showEntriesFor());
</script>
