---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      imageOnRight: index % 2 === 1,
      nextPosts: posts
        .filter((entry) => entry.id !== post.id)
        .slice(0, 3)
    }
  }));
}

const { post, imageOnRight, nextPosts } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} | Dare to Break Free`} description={post.data.excerpt} pageClass="article-page">
  {post.data.coverImage && (
    <header class={`article-hero${imageOnRight ? " article-hero--image-right" : ""}`}>
      <div class="article-hero__inner">
        <div class="article-hero__image">
          <img src={post.data.coverImage} alt={`Cover image for ${post.data.title}`} />
        </div>
        <div class="article-hero__content">
          <h1>{post.data.title}</h1>
        </div>
      </div>
    </header>
  )}
  <article class="article">
    {!post.data.coverImage && (
      <>
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.excerpt}</p>
      </>
    )}
    <div class="prose">
      <Content />
    </div>
  </article>
  <section class="article-next" aria-labelledby="article-next-title">
    <div class="article-next__inner">
      <div class="article-next__heading">
        <p class="eyebrow">Keep reading</p>
        <h2 id="article-next-title">What to read next</h2>
      </div>
      {nextPosts.length > 0 && (
        <div class="article-next__grid">
          {nextPosts.map((nextPost) => <PostCard post={nextPost} />)}
        </div>
      )}
      <a class="article-next__all" href={`${import.meta.env.BASE_URL}journal/`}>Browse all journal entries</a>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const requestedGutter = new URLSearchParams(window.location.search).get("gutter");
  if (requestedGutter === "plum" || requestedGutter === "teal") {
    document.body.dataset.gutter = requestedGutter;
  }
</script>

<style>
  :global(body.article-page) {
    --frame-gutter: #d4f1f1;
    background: var(--frame-gutter);
  }

  :global(body.article-page[data-gutter="plum"]) {
    --frame-gutter: #291528;
  }

  :global(body.article-page .site-frame) {
    width: min(1480px, calc(100% - clamp(1rem, 5vw, 5rem) * 2));
    min-height: calc(100vh - 2 * clamp(1rem, 3.8vw, 3.5rem));
    margin: clamp(1rem, 3.8vw, 3.5rem) auto;
    background: var(--paper);
    box-shadow: 0 0.5rem 2rem rgba(28, 33, 32, 0.12);
  }

  :global(body.article-page .site-header),
  :global(body.article-page .site-footer) {
    width: 100%;
    max-width: none;
    padding-inline: clamp(1.25rem, 4vw, 3.5rem);
  }

  :global(body.article-page .site-header) {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--paper);
    box-shadow: none;
  }

  :global(body.article-page main) {
    width: 100%;
    min-height: 0;
    background: var(--paper);
  }

  .article-hero,
  .article {
    width: 100%;
    max-width: none;
    margin: 0;
  }

  .article-hero {
    display: block;
    min-height: 0;
    padding: clamp(1.25rem, 2.5vw, 2rem) clamp(1.25rem, 5vw, 5rem);
    background: var(--paper);
  }

  .article-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    grid-template-areas: "image content";
    align-items: center;
    gap: clamp(1.5rem, 3.5vw, 3rem);
    width: min(100%, 88ch);
    margin-inline: auto;
  }

  .article-hero--image-right .article-hero__inner {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    grid-template-areas: "content image";
  }

  .article-hero__image {
    grid-area: image;
    min-width: 0;
  }

  .article-hero__image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .article-hero__content {
    grid-area: content;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .article-hero__content h1 {
    max-width: none;
    margin: 0;
    font-size: clamp(2rem, 3vw, 3.25rem);
    line-height: 1.08;
    text-wrap: balance;
  }

  .article {
    padding: clamp(1.5rem, 3vw, 2.75rem) clamp(1.25rem, 5vw, 5rem);
  }

  .prose {
    width: min(100%, 88ch);
    margin: 0 auto;
    line-height: 1.75;
  }

  .article-next {
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.25rem, 5vw, 5rem);
    border-top: 1px solid var(--line);
    background: #eef3f6;
  }

  .article-next__inner {
    width: min(100%, 88rem);
    margin-inline: auto;
  }

  .article-next__heading {
    margin-bottom: 1.5rem;
  }

  .article-next__heading .eyebrow {
    margin: 0 0 0.5rem;
  }

  .article-next__heading h2 {
    margin: 0;
  }

  .article-next__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 1rem;
  }

  .article-next__all {
    display: inline-block;
    margin-top: 1.25rem;
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 640px) {
    :global(body.article-page .site-frame) {
      width: calc(100% - 0.75rem);
      min-height: calc(100vh - 1rem);
      margin-block: 0.5rem;
    }

    :global(body.article-page .site-header) {
      position: static;
      padding-inline: var(--page-gutter);
      box-shadow: none;
    }

    .article-hero {
      padding: 1.25rem var(--page-gutter) 1.5rem;
    }

    .article-hero__inner,
    .article-hero--image-right .article-hero__inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "image" "content";
      gap: 1.5rem;
    }

    .article {
      padding-inline: var(--page-gutter);
    }

    .article-hero__content h1 {
      max-width: none;
    }

    .prose {
      margin-inline: auto;
    }
  }

  @media (min-width: 641px) and (max-width: 820px) {
    .article-hero__inner,
    .article-hero--image-right .article-hero__inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "image" "content";
      gap: 1.5rem;
    }

    .article-hero__image {
      max-width: 36rem;
    }
  }
</style>
