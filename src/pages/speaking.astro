---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/speaking-page.css";
import speakingHero from "../assets/speaking-page-hero.jpg";

const formAction = "https://formspree.io/f/xwlpaqpg";
---

<BaseLayout title="Speaking | Dare to Break Free">
  <section class="page-hero speaking-hero" style={`--speaking-hero-image: url("${speakingHero.src}")`}>
    <div class="speaking-hero__copy">
      <p class="speaking-hero__eyebrow"><strong>Speaking about</strong></p>
      <h1>Grit, Resilience &amp; Midlife Reinvention</h1>
    </div>
  </section>

  <section class="speaking-intro" aria-label="Speaking experience and testimonials">
    <div class="speaking-intro__copy">
      <p>I speak from lived experience, years of study in areas such as nutritional science and positive psychology, a huge amount of self-experimentation, and the long process of writing <em>Dare to Break Free</em>.</p>
      <p>That covers a lot of ground, I know, so to help make sense of what I can bring to your audience, these are the themes that sit at the heart of what I talk about.</p>
    </div>
    <aside class="speaking-testimonials" aria-label="Audience feedback">
      <blockquote><strong>“Kali has a knack for involving the audience with her confiding style.”</strong></blockquote>
      <blockquote><strong>“Vulnerable, honest, personal storytelling.”</strong></blockquote>
      <blockquote><strong>“Powerful story.”</strong></blockquote>
    </aside>
  </section>

  <section class="form-section">
    <div>
      <p class="eyebrow">Message</p>
      <h2>Send a note</h2>
      <p>The site uses a form-first contact flow so the public email address does not have to sit exposed on every page.</p>
    </div>
    <form class="contact-form" action={formAction} method="POST">
      <div class="contact-form__honeypot" aria-hidden="true">
        <label for="contact-website">Leave this field empty</label>
        <input id="contact-website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <label>
        Name
        <input name="name" type="text" autocomplete="name" required />
      </label>
      <label>
        Email
        <input name="email" type="email" autocomplete="email" required />
      </label>
      <label>
        Message
        <textarea name="message" rows="7" required></textarea>
      </label>
      <input type="hidden" name="form-name" value="contact" />
      <button class="button" type="submit">Send message</button>
    </form>
  </section>
</BaseLayout>
